{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "frontend-against-local-test-backend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["API_BASE_URL=http://localhost:8099", "PORT=3000", "pnpm", "--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "env",
      "runtimeArgs": ["ACCESS_TOKEN_SECRET=preview-test-secret", "REFRESH_TOKEN_SECRET=preview-test-secret", "go", "run", "."],
      "cwd": "backend",
      "port": 8080
    }
  ]
}
